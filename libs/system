func sys_getos() { 
    return __builtin_os();
};
func sys_cd(dir) {
    return __builtin_chdir(dir);
};
func sys_exec(cmd) {
    return __builtin_exec(cmd);
};
func sys_read(msg) {
    return __builtin_read(msg);
};
func sys_sleep() {
    current_os = get_os();
    if(current_os == "linux") {
        exec("systemctl poweroff");
    }
    else if(current_os == "windows") {
        exec("shutdown /s /t 0");
    }
    else if(current_os == "android") {
        exec("echo shutdown android only on root");
        exec("su -c reboot -p");
    }
    else if(current_os == "macos") {
        exec("sudo shutdown -h now");
    }
    else {
        exec("echo i dont know this system");
    }
};
func sys_getcwd() {
    return __builtin_getcwd();
};
