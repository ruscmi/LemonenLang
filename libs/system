func get_os() { 
    return __builtin_os();
};
func exec(cmd) {
    return __builtin_exec(cmd);
};
func read(msg) {
    return __builtin_read(msg);
};
func sleep() {
    current_os = get_os();
    if(current_os == "linux") {
        exec("systemctl suspend");
    }else {
        exec("echo i dont know this system")
    }
};
func getcwd() {
    return __builtin_getcwd();
};
