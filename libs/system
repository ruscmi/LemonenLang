func sys_getos() { 
    return __builtin_os()
};
func sys_cd(dir) {
    return __builtin_chdir(dir)
};
func sys_exec(cmd) {
    return __builtin_exec(cmd)
};
func sys_read(msg) {
    return __builtin_read(msg)
};
func sys_sleep() {
    current_os = sys_getos()
    if(current_os == "linux") {
        sys_exec("systemctl poweroff")
    }
    else if(current_os == "windows") {
        sys_exec("shutdown /s /t 0")
    }
    else if(current_os == "android") {
        sys_exec("echo shutdown android only on root")
        sys_exec("su -c reboot -p")
    }
    else if(current_os == "macos") {
        sys_exec("sudo shutdown -h now")
    }
    else {
        sys_exec("echo i dont know this system")
    }
};
func sys_getcwd() {
    return __builtin_getcwd()
};
func sys_keypressed(key) {
	return __builtin_keypressed(key)
};
