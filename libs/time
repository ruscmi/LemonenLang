func time_lmit(time) {
	return __builtin_wait(time)
};

func time_current() {
	return __builtin_gettime()
};

func time_zone(time) {
	return __builtin_zonetime(time)
};
func time_format(sec) {
	return __builtin_consttime(sec)
};
func time_gettime() {
	return __builtin_spectime()
};
