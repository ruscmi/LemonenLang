// FUNCTIONS

func math_fibonacci(n) {
	if( n <= 0) return 0;
	if( n == 1) return 1;
	a = 0
	b = 1
	c = 0
	for(i = 2; i <= n; i = i + 1) {
		c = a + b
		a = b
		b = c
	}
	return c
};
func math_iseven(num) {
	if(lmtype(num) == "NUM") {
		if(num % 2 == 0) {
			return "yes"
		}
		else if(num % 2 != 0) {
			return "no"
		}
	}else {
		return "unknown datatype"
	}
};
func math_degree(num,deg) {
	if(deg == 0) {
		return 1;
	}
	if(deg < 0) {
		num = 1 / num
		deg = -deg
	}
	res = 1
	while(deg > 0) {
		if(deg % 2 != 0) {
			res = res * num
		}
		num = num * num
		deg = (deg - (deg % 2)) / 2 
	}
	return res
};
func math_floor(num) {
	if( num >= 0) {
		return num - ( num % 1 )
	}else {
		rem = num % 1
		if(rem == 0) {
			return num
		}
		return num - rem - 1
	}
};

// CONSTANTS

math_constPI = 3.14159265;
math_constE = 2.71828182;
math_inf = math_degree(10,309);
math_nan = math_floor(math_inf);
