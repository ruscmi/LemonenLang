/- --COLORS-- -/

func paint_black(string) {
    string = "\033[30m",string,"\033[0m"
    return string
};
func paint_red(string) {
    string = "\033[31m",string,"\033[0m"
    return string
};
func paint_green(string) {
    string = "\033[32m",string,"\033[0m"
    return string
};
func paint_yellow(string) {
    string = "\033[33m",string,"\033[0m"
    return string
};
func paint_blue(string) {
    string = "\033[34m",string,"\033[0m"
    return string
};
func paint_magenta(string) {
    string = "\033[35m",string,"\033[0m"
    return string
};
func paint_cyan(string) {
    string = "\033[36m",string,"\033[0m"
    return string
};
func paint_white(string) {
    string = "\033[37m",string,"\033[0m"
    return string
};

/- --CLEARING-- -/

func clear_screen() {
    lmuck("\033[2J\033[H")
};
func clear_line() {
    lmuck("\033[2K\r")
};

/- --WRITING-- -/

func dim_write(string) {
    string = "\033[2m",string,"\033[0m"
    return string
};
func italic_write(string) {
