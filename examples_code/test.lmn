code = lmout("inp: ");
len = lmlen(code);
i = 0;
while(i<len) {
    if(code == " ") {
        i = i + 1;
        continue;
    }
    if(code == "string") {
        lmuck(1);
        i = i + 1
        if(code == "=") {
            lmuck(2);
            i = i + 1
        }
    }else {
        lmuck("UNK")
        i = i + 1
    }
}
