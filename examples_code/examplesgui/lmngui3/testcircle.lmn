lmport(lmngui);

lgui_initwindow(600,600,"circle");
lgui_setfps(60);
while(lgui_windowshutdown()) {
	lgui_begdrawing();
	lgui_bgdrawing(0,0,108);
	lgui_draw_circle(100,100,50,255,255,0,255);
	lgui_draw_linesector(200,200,50,10,30,0,255,0,0,255);
	lgui_draw_sector(300,300,50,10,30,0,255,255,255,255);
	lgui_draw_linecircle(400,400,50,0,0,0,255);
	lgui_textdrawing("lmnlang",70,85,20,0,0,0,255)
	lgui_enddrawing()
};
lgui_closewindow()
