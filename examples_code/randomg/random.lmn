#!/usr/bin/env lmnlang
/-guess the next number game-/
lmport(random);
lmport(string);
lmport(ansi);
lmport"load.lmn";
loading();
control();
lmuck(paint_blue("\tGuess the Next Number Game\n\tGNNG license GPL 2.0 by Richard Stolman\n\tgame by ruscmi"));
lmuck("первое число 3781");
i = 0;
vars = [];
while(true) {
    while(true) {
        while(i < 2) {
            var = rnd_randint(1,100);
            vars.lmpush(var);
            i = i + 1;
        }
        o = 0;
        if(i != vars[o]) {
            break;
        }
    }
    get_str = str_join(vars,"");
    lmuck(get_str);
    choiser = lmout("угадай число или 'exit' для выхода: ");
    lmit(0.1);
    mem = [];
    mem.lmpush(get_str);
    mem_res = str_join(mem,"");
    if(choiser == mem_res) {
        var = rnd_randint(1,100);
        vars.lmpush(var);
    }
    if(choiser == "exit") {
        lmuck("Goodbye!");
        break;
    }
    if(lmlen(get_str) >= 10) {
        lmuck("МОЛОДЕЦ!");
        break;
    }
    if(choiser == get_str) {
        lmuck("можешь продолжать");
    }
}
