#!/usr/bin/env lmnlang
lmport(ansi);
lmport(system);
func loading() {
    width = 12; 
    pos_x = 0;  
    dir_x = 1;  
    i = 0;
    while(i < 40) {
        clear_screen();
        lmuck("\n\n\n\n\n\n\n\n\n\n\n\n");
        x = 0;
        line = "";
        lmuck(paint_blue("\t\t\t\t\t\t\t\t=============="))
        while(x < width) {
            if(x == pos_x) {
                line = line, paint_yellow("  ");
            } else {
                line = line, paint_yellow("-");
            };
            x = x + 1;
        }
        lmuck("\t\t\t\t\t\t\t\t",line);
        lmuck(paint_blue("\t\t\t\t\t\t\t\t=============="))
        if(pos_x == width - 1) {
            dir_x = -1; 
        };
        if(pos_x == 0) {
            dir_x = 1;  
        };

        pos_x = pos_x + dir_x;
        
        lmit(0.1);
        i = i + 1;
    }
};
func control() {
    clear_screen()
    lmit(1);
    while(true) {
        lmuck("\n\n\n\n\n\n\n\n\n\n\n\n\n\t\t\t\t\t\t\t\t",paint_green("LOADING SUCCEFULL"))
        inpl = lmout("\n\n\n\t'enter' for continue...");
        if(inpl == "") {
            clear_screen();
            break;
        }else {
            clear_screen();
            continue;
        }
    }
}
